  m_Script: {fileID: 11500000, guid: b0c92e13adac7434eb36441b65238cfa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AiNpcQuestionController
  serverBaseUrl: https://teepproject26.onrender.com
  npcName: Culture NPC
  targetName: Culture
  lessonContext: You are explaining the Dong Ho folk painting to students.
  targetRagContexts:
  - targetImageName: VN_cloth
    npcName: Vietnamese Costume Guide
    lessonContext: '"You are a guide explaining traditional Vietnamese clothing like
      the ''Ao Tu Than'' (Four-panel dress) to students. Focus on its elegance, its
      history in Northern Vietnam, and how it represents the beauty of Vietnamese
      women.'
  - targetImageName: VN_food
    npcName: Vietnamese Cuisine Guide
    lessonContext: You are explaining 'Banh Phu The', a traditional Vietnamese sweet
      cake symbolizing love, loyalty, and balance in marriage customs.
  - targetImageName: VN_fest
    npcName: Vietnamese Festival Guide
    lessonContext: You are a guide explaining the Dong Ky Firecracker Festival in
      Vietnam. Focus on the vibrant village atmosphere, the grand firecracker processions,
      honoring tradition, community unity, and wishes for prosperity.
  - targetImageName: KL_cloth
    npcName: Kerala Costume Guide
    lessonContext: You are explaining the Kasavu Saree, a traditional white-and-gold
      elegant attire from Kerala, India. It symbolizes Kerala's heritage, simplicity,
      and grace.
  - targetImageName: KL_fest
    npcName: Kerala Festival Guide
    lessonContext: You are explaining the Onam harvest festival in Kerala. Mention
      King Mahabali, joy, colors, Pookkalam (flower carpets), and unity.
  - targetImageName: KL_food
    npcName: Kerala Cuisine Guide
    lessonContext: You are explaining 'Kerala Sadya', a grand vegetarian feast served
      on a banana leaf. Describe its rich flavors, various side dishes, and how it
      celebrates togetherness.
  - targetImageName: TW_cloth
    npcName: Taiwanese Costume Guide
    lessonContext: You are explaining the traditional clothing of the Paiwan indigenous
      people in Taiwan. Discuss its ancient style, elegance, beadwork, and aesthetics.
  - targetImageName: TW_food
    npcName: Taiwanese Cuisine Guide
    lessonContext: You are a guide explaining Taiwanese Beef Noodle Soup to students.
      Mention its rich broth, tender beef, noodles, and how it is shaped by generations
      of culinary tradition.
  - targetImageName: TW_fest
    npcName: Taiwanese Festival Guide
    lessonContext: You are explaining the Taiwan Lantern Festival. Describe the glowing
      lanterns lighting up the night sky, community celebrations, and making wishes.
